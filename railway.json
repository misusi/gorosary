{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "npm run build:packages && npm run build --workspace @gorosary/web"
  },
  "deploy": {
    "startCommand": "npm run start --workspace @gorosary/web -- --hostname 0.0.0.0",
    "healthcheckPath": "/",
    "healthcheckTimeout": 180,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
