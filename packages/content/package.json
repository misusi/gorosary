{
  "name": "@gorosary/content",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Single source of truth for GoRosary prayer content, navigation, and the liturgical calendar.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./content": {
      "types": "./dist/generated/content.d.ts",
      "import": "./dist/generated/content.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsx scripts/build-content.ts && tsc -p tsconfig.json",
    "check": "tsx scripts/build-content.ts --check",
    "list": "tsx scripts/build-content.ts --list",
    "plan": "tsx scripts/plan-lectionary.ts",
    "check:lectionary": "tsx scripts/check-lectionary.ts",
    "dev": "tsx watch scripts/build-content.ts",
    "test": "node --import tsx --test \"test/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
